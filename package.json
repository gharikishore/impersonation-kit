{
  "name": "@gharikishore/impersonation-kit",
  "version": "0.1.0",
  "description": "Reusable admin-impersonation library for Next.js + Drizzle apps. Pluggable auth, schema, and UI theme; ships route handler factories + themeable React components + audit-log auto-stamping.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./routes": "./src/routes/index.ts",
    "./ui": "./src/ui/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "echo 'no linter yet'"
  },
  "keywords": [
    "nextjs",
    "drizzle",
    "impersonation",
    "admin",
    "audit-log",
    "supabase"
  ],
  "author": "Hari Gunupudi <harigunupudi@gmail.com>",
  "license": "UNLICENSED",
  "private": true,
  "peerDependencies": {
    "next": ">=14",
    "react": ">=18",
    "drizzle-orm": ">=0.30",
    "lucide-react": ">=0.300.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "typescript": "^5.4"
  }
}
